# CivicFix AI Configuration
# Ollama local endpoint (default is localhost port 11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Installed model tag
OLLAMA_MODEL=gemma4:e2b

# Request timeout in milliseconds (120 seconds default for local inference)
OLLAMA_TIMEOUT_MS=120000

# Safety limit on maximum tool calls per complaint invocation
MAX_TOOL_CALLS=3

# Safe maximum character limit for complaint descriptions
MAX_INPUT_LENGTH=4000
